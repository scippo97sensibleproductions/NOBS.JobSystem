@page "/jobs"
@layout MainLayout
@inject JobStatusService JobStatusService

<PageTitle>Job Dashboard</PageTitle>
<HeadContent>
    <meta http-equiv="refresh" content="30">
</HeadContent>

@if (_jobs is null)
{
    <p>Loading job statuses...</p>
}
else if (_jobs.Count == 0)
{
    <p>No scheduled jobs are registered in the system.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Job Name</th>
            <th>Last Successful Run (UTC)</th>
            <th>Next Scheduled Run (UTC)</th>
            <th>CRON Schedule</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var job in _jobs)
        {
            <tr>
                <td data-label="Job Name">@job.JobName</td>
                <td data-label="Last Run">@FormatDateTime(job.LastRunUtc)</td>
                <td data-label="Next Run">@FormatDateTime(job.NextRunUtc)</td>
                <td data-label="Schedule">@job.CronExpression</td>
                <td data-label="Actions">
                    <form method="post" action="/jobs/trigger">
                        <input type="hidden" name="jobName" value="@job.JobName" />
                        <button type="submit" class="button-force-run">Force Run</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<JobStatusDto>? _jobs;

    protected override async Task OnInitializedAsync()
    {
        _jobs = await JobStatusService.GetJobStatusesAsync(CancellationToken.None);
    }

    private static string FormatDateTime(DateTime? dt) => dt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A";
}